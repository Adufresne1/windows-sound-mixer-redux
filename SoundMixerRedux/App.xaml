<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SoundMixerRedux.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SoundMixerRedux"
    xmlns:conv="using:SoundMixerRedux.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="MuteBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SoloBrush" Color="#FFD479" />
                    <SolidColorBrush x:Key="MuteSoftBrush" Color="#29FF99A4" />
                    <SolidColorBrush x:Key="SoloSoftBrush" Color="#29FFD479" />
                    <SolidColorBrush x:Key="MuteBorderBrush" Color="#73FF99A4" />
                    <SolidColorBrush x:Key="SoloBorderBrush" Color="#73FFD479" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MuteBrush" Color="#C4314B" />
                    <SolidColorBrush x:Key="SoloBrush" Color="#8A6D00" />
                    <SolidColorBrush x:Key="MuteSoftBrush" Color="#29C4314B" />
                    <SolidColorBrush x:Key="SoloSoftBrush" Color="#298A6D00" />
                    <SolidColorBrush x:Key="MuteBorderBrush" Color="#73C4314B" />
                    <SolidColorBrush x:Key="SoloBorderBrush" Color="#738A6D00" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters -->
            <conv:PercentToHeightConverter x:Key="PercentToHeight" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- VU meter colour zones (theme-independent): green ≤ -6 dB, yellow -6→-2, red -2→0 -->
            <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#35C46F" Offset="0.0" />
                <GradientStop Color="#35C46F" Offset="0.66" />
                <GradientStop Color="#FFCF4D" Offset="0.68" />
                <GradientStop Color="#FFCF4D" Offset="0.865" />
                <GradientStop Color="#FF5964" Offset="0.885" />
                <GradientStop Color="#FF5964" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
