<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SoundMixerRedux.Controls.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsEnabled="{Binding NotDimmed}"
    mc:Ignorable="d">

    <Grid
        Width="128"
        Padding="10,16,10,14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel HorizontalAlignment="Stretch">

            <!--  App / device tile: Fluent glyph for Master, initials otherwise  -->
            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                Background="{Binding TileColor, Converter={StaticResource HexToBrush}}"
                CornerRadius="10">
                <Grid>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="White"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding IsMaster, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Initials}"
                        Visibility="{Binding IsMaster, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{Binding VolumeLabel}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="%" />
            </StackPanel>

            <!--  Fader wrap: VU meter + vertical slider  -->
            <Grid
                Height="190"
                Margin="0,14,0,12"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="4"
                    Height="180"
                    Margin="0,0,9,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    CornerRadius="3">
                    <Rectangle
                        VerticalAlignment="Bottom"
                        Height="{Binding Peak, Converter={StaticResource PercentToHeight}, ConverterParameter=180}"
                        Fill="{StaticResource MeterBrush}"
                        RadiusX="3"
                        RadiusY="3" />
                </Border>

                <Slider
                    Grid.Column="1"
                    Width="24"
                    Height="180"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    Orientation="Vertical"
                    Value="{Binding Volume, Mode=TwoWay}" />
            </Grid>

            <!--  Mute / Solo  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <ToggleButton
                    Width="34"
                    Height="30"
                    MinWidth="34"
                    Padding="0"
                    Content="M"
                    CornerRadius="5"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsMuted, Mode=TwoWay}"
                    ToolTipService.ToolTip="Muet">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FF99A4" />
                    </ToggleButton.Resources>
                </ToggleButton>
                <ToggleButton
                    Width="34"
                    Height="30"
                    MinWidth="34"
                    Padding="0"
                    Content="S"
                    CornerRadius="5"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsSoloed, Mode=TwoWay}"
                    ToolTipService.ToolTip="Solo">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FFD479" />
                    </ToggleButton.Resources>
                </ToggleButton>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
