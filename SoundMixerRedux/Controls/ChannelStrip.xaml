<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SoundMixerRedux.Controls.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsEnabled="{Binding NotDimmed}"
    mc:Ignorable="d">

    <Grid
        Width="128"
        Padding="10,16,10,14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel HorizontalAlignment="Stretch" Padding="6,0">

            <!--  App / device tile: Fluent glyph for Master, initials otherwise  -->
            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                Background="{Binding TileColor, Converter={StaticResource HexToBrush}}"
                CornerRadius="10">
                <Grid>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="White"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}" />
                    <Image
                        Width="24"
                        Height="24"
                        Source="{Binding IconImage}"
                        Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Initials}"
                        Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding VolumeLabel}" />

            <!--  Fader wrap: VU meter + vertical slider  -->
            <Grid
                Height="190"
                Margin="0,14,0,12"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  dB scale (Master strip only, toggled): positions map to dBFS floor of -48 dB over 180 px  -->
                <Canvas
                    Grid.Column="0"
                    Width="22"
                    Height="180"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowScale, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Canvas.Top="-7" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="0" TextAlignment="Right" />
                    <TextBlock Canvas.Top="15.5" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-6" TextAlignment="Right" />
                    <TextBlock Canvas.Top="38" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-12" TextAlignment="Right" />
                    <TextBlock Canvas.Top="68" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-20" TextAlignment="Right" />
                    <TextBlock Canvas.Top="105.5" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-30" TextAlignment="Right" />
                    <TextBlock Canvas.Top="167" Width="22" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-&#8734;" TextAlignment="Right" />
                </Canvas>

                <Border
                    Grid.Column="1"
                    Width="4"
                    Height="180"
                    Margin="0,0,9,0"
                    VerticalAlignment="Center"
                    CornerRadius="3">
                    <!--  Full-height gradient = fixed dB colour zones; the top mask hides the unfilled part.  -->
                    <Grid>
                        <Rectangle Fill="{StaticResource MeterBrush}" />
                        <Rectangle
                            VerticalAlignment="Top"
                            Height="{Binding Peak, Converter={StaticResource PercentToRemainingHeight}, ConverterParameter=180}"
                            Fill="{ThemeResource MeterTrackBrush}" />
                    </Grid>
                </Border>

                <Slider
                    Grid.Column="2"
                    Width="32"
                    Height="180"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    Orientation="Vertical"
                    Value="{Binding Volume, Mode=TwoWay}" />
            </Grid>

            <!--  Mute / Solo  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <ToggleButton
                    Width="34"
                    Height="30"
                    MinWidth="34"
                    Padding="0"
                    Content="M"
                    CornerRadius="5"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsMuted, Mode=TwoWay}"
                    ToolTipService.ToolTip="Muet">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FF99A4" />
                    </ToggleButton.Resources>
                </ToggleButton>
                <ToggleButton
                    Width="34"
                    Height="30"
                    MinWidth="34"
                    Padding="0"
                    Content="S"
                    CornerRadius="5"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsSoloed, Mode=TwoWay}"
                    ToolTipService.ToolTip="Solo">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FFD479" />
                    </ToggleButton.Resources>
                </ToggleButton>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
