<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SoundMixerRedux.Controls.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Opacity="{Binding StripOpacity}"
    Visibility="{Binding ShowInList, Converter={StaticResource BoolToVisibility}}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  The default vertical Slider template's inner grid has fixed Pre/PostContentMargin columns
        (14px each) flanking the track, which floor its natural width at 32px regardless of MinWidth —
        that's why zeroing SliderVerticalWidth alone wasn't enough. Zeroing the margins too collapses
        the floor down to just the round thumb's own fixed size (18px), which fits our smallest scaled
        Slider width and stops the thumb from overflowing/clipping at low Scale.  -->
        <x:Double x:Key="SliderVerticalWidth">0</x:Double>
        <x:Double x:Key="SliderPreContentMargin">0</x:Double>
        <x:Double x:Key="SliderPostContentMargin">0</x:Double>
    </UserControl.Resources>

    <Grid
        Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=128}"
        Padding="10,16,10,14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel HorizontalAlignment="Stretch" Padding="6,0">

            <!--  App / device tile: Fluent glyph for Master, initials otherwise  -->
            <Border
                Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=40}"
                Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=40}"
                HorizontalAlignment="Center"
                Background="{Binding TileColor, Converter={StaticResource HexToBrush}}"
                CornerRadius="10">
                <Grid>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=20}"
                        Foreground="White"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}" />
                    <Image
                        Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=24}"
                        Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=24}"
                        Source="{Binding IconImage}"
                        Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=15}"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Initials}"
                        Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=14}"
                        Foreground="Red"
                        Glyph="&#xE7B3;"
                        Visibility="{Binding ShowHiddenBadge, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=13}"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=12}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding VolumeLabel}" />

            <!--  Fader wrap: VU meter + vertical slider  -->
            <Grid
                Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=190}"
                Margin="0,14,0,12"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  dB scale (Master strip only, toggled): positions map to dBFS floor of -48 dB over 180 px  -->
                <Canvas
                    Grid.Column="0"
                    Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}"
                    Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=180}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowScale, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=-7}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="0" TextAlignment="Right" />
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=15.5}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-6" TextAlignment="Right" />
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=38}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-12" TextAlignment="Right" />
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=68}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-20" TextAlignment="Right" />
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=105.5}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-30" TextAlignment="Right" />
                    <TextBlock Canvas.Top="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=167}" Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=9}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="-&#8734;" TextAlignment="Right" />
                </Canvas>

                <Border
                    Grid.Column="1"
                    Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=4}"
                    Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=180}"
                    Margin="0,0,9,0"
                    VerticalAlignment="Center"
                    CornerRadius="3">
                    <!--  Full-height gradient = fixed dB colour zones; the top mask hides the unfilled part.  -->
                    <Grid>
                        <Rectangle Fill="{StaticResource MeterBrush}" />
                        <Rectangle
                            VerticalAlignment="Top"
                            Height="{Binding MeterMaskHeight}"
                            Fill="{ThemeResource MeterTrackBrush}" />
                    </Grid>
                </Border>

                <Slider
                    Grid.Column="2"
                    Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=32}"
                    Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=180}"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    Orientation="Vertical"
                    Value="{Binding Volume, Mode=TwoWay}" />
            </Grid>

            <!--  Mute / Solo  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <ToggleButton
                    Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=34}"
                    Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=30}"
                    Padding="0"
                    BorderThickness="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=1}"
                    Content="M"
                    CornerRadius="5"
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=14}"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsMuted, Mode=TwoWay}"
                    IsEnabled="{Binding MuteEnabled}"
                    ToolTipService.ToolTip="Muet">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF99A4" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FF99A4" />
                    </ToggleButton.Resources>
                </ToggleButton>
                <ToggleButton
                    Width="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=34}"
                    Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=30}"
                    Padding="0"
                    BorderThickness="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=1}"
                    Content="S"
                    CornerRadius="5"
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=14}"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsSoloed, Mode=TwoWay}"
                    ToolTipService.ToolTip="Solo"
                    Visibility="{Binding ShowSolo, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#29FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3DFFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#52FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFD479" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#73FFD479" />
                    </ToggleButton.Resources>
                </ToggleButton>
            </StackPanel>
        </StackPanel>

        <!--  Fully transparent hit-target: while "manage hidden tracks" is active, any click on the
        card toggles IsHidden instead of reaching the fader/Mute/Solo underneath.  -->
        <ToggleButton
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            BorderThickness="0"
            IsChecked="{Binding IsHidden, Mode=TwoWay}"
            Visibility="{Binding CanToggleHidden, Converter={StaticResource BoolToVisibility}}">
            <ToggleButton.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
            </ToggleButton.Resources>
        </ToggleButton>
    </Grid>
</UserControl>
