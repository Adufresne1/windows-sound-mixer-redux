<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SoundMixerRedux.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:SoundMixerRedux.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SoundMixerRedux.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:MixerViewModel />
    </Page.DataContext>

    <!--  Board at natural size (DPI handled by the framework); scrolls if it overflows the window.  -->
    <ScrollViewer
        x:Name="ContentScroller"
        x:FieldModifier="public"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        ZoomMode="Disabled">
    <Grid Padding="16,8,16,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  OUTPUTS  -->
        <StackPanel Grid.Column="0">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Settings gear / Done (hidden-track selection mode) + hidden-tracks indicator  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="7">
                    <DropDownButton
                        Padding="10,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{Binding HiddenTrackSelectionModeActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xE713;" />
                            <TextBlock x:Uid="SettingsButtonText" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <ToggleMenuFlyoutItem x:Uid="AlwaysOnTopMenuItem" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem x:Uid="ShowDbScaleMenuItem" IsChecked="{Binding ShowDbScale, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem x:Uid="PinnedMenuItem" IsChecked="{Binding Pinned, Mode=TwoWay}" />
                                <MenuFlyoutItem x:Uid="ManageHiddenTracksMenuItem" Command="{Binding ManageHiddenTracksCommand}" />
                                <MenuFlyoutItem x:Uid="CloseAppMenuItem" Command="{Binding CloseAppCommand}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Uid="FinishSelectionButton"
                        Command="{Binding FinishHiddenTrackSelectionCommand}"
                        Visibility="{Binding HiddenTrackSelectionModeActive, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon
                        x:Uid="HiddenTracksIndicator"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Foreground="{Binding HiddenChannelPlayingSound, Converter={StaticResource BoolToAlertBrush}}"
                        Glyph="&#xE7B3;"
                        Visibility="{Binding AnyChannelHidden, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!--  Section label + device selector  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="11">
                    <TextBlock
                        x:Uid="OutputSectionLabel"
                        VerticalAlignment="Center"
                        CharacterSpacing="60"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ComboBox
                        MinWidth="200"
                        MaxWidth="260"
                        ItemsSource="{Binding OutputDevices}"
                        SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Outputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:ChannelStrip />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Divider  -->
        <Rectangle
            Grid.Column="1"
            Width="1"
            Margin="10,6,10,30"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  INPUTS  -->
        <StackPanel Grid.Column="2">
            <StackPanel
                Margin="4,0,4,12"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="11">
                <TextBlock
                    x:Uid="InputSectionLabel"
                    VerticalAlignment="Center"
                    CharacterSpacing="60"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ComboBox
                    MinWidth="180"
                    MaxWidth="240"
                    ItemsSource="{Binding InputDevices}"
                    SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" />
            </StackPanel>

            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Inputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:ChannelStrip />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
